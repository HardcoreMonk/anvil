# [v0.7.0 학습 주석] 유닛 템플릿. install.sh의 install_service()가
# `sed "s|@DEST@|$DEST|g"`로 @DEST@ 세 자리(WorkingDirectory, Environment,
# EnvironmentFile/ExecStart 경로)를 실제 설치 경로로 한 번에 치환해
# /etc/systemd/system/ephemera.service를 만든다. 이 파일 자체는 설치 시
# 실행되지 않고 항상 치환 후 결과물만 배치된다.
[Unit]
Description=Ephemera control plane (Firecracker MicroVM orchestrator)
Documentation=https://github.com/steve-seungeui/ephemera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@DEST@
# EPHEMERA_HOME=@DEST@는 cmd/goose-daemon/main.go의 resolveWorkDir()이 읽는 값과
# 동일하다 — daemon이 systemd 밖에서 기동돼도(dev 환경) 이 env가 없으면
# os.Getwd()로 폴백하므로, 유닛에서 이 줄을 지우면 WorkingDirectory와 어긋날 수 있다.
Environment=EPHEMERA_HOME=@DEST@
EnvironmentFile=@DEST@/ephemera.env
ExecStart=@DEST@/ephemera-daemon
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
# First boot of the SLIM package bakes the golden image (debootstrap) inside the
# process, which can take several minutes — do not let systemd time it out.
TimeoutStartSec=0
LimitNOFILE=65536
# No ProtectSystem/PrivateTmp/sandbox on purpose: the daemon needs /dev/kvm, raw
# networking (iptables/dmsetup/TAP), and loop mounts under /tmp/goose-workspaces.
# A hardened unit would break VM provisioning. Keep the API on localhost + a token
# (see ephemera.env) and expose it only behind a reverse proxy.

[Install]
WantedBy=multi-user.target
