# Credentials for MCP gateway backend servers, referenced by key from
# configs/mcp/servers.yaml (a server's `credential:` field). The gateway injects
# each as "Authorization: Bearer <token>" when calling that backend.
#
# These tokens live ONLY on the host and are never sent to a VM. Copy to
# configs/mcp/secrets.yaml and fill in real values.
#
# configs/mcp/secrets.yaml is gitignored — never commit real tokens.

example_token: your-token-here
