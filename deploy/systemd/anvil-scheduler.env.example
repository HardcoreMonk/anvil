# anvil scheduler service environment.
#
# Copy to /etc/anvil/anvil-scheduler.env and adjust paths if needed.
# The scheduler binds to loopback by default; put it behind a local reverse
# proxy or private network policy before exposing it beyond the host.

ANVIL_SCHEDULER_ADDR=127.0.0.1:3010
ANVIL_SCHEDULER_STATE=/var/lib/anvil/scheduler.json
ANVIL_SCHEDULER_QUOTA_STORE=/var/lib/anvil/tenants.json
