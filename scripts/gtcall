#!/bin/sh
# gtcall — dispatch a prompt to another agent in this VM's flock.
#
# Usage:
#   gtcall <agent_id> <prompt>
#
# Dispatches the prompt to the named agent through the local control plane's
# flock call endpoint. The daemon resolves the agent (locally or via the routed-
# flock home daemon) and injects the target VM's agent token itself — the calling
# agent never learns peer credentials or peer addresses.
#
# Reads:
#   /root/.ephemera-flock          flock metadata (FLOCK_ID, AGENT_ID)
#   /root/.ephemera-cp-token       CP bearer (preferred; injected at spawn)
#   $EPHEMERA_CONTROL_PLANE_TOKEN  CP bearer (fallback for legacy images)
#   $EPHEMERA_CONTROL_PLANE        CP URL override (default http://10.0.1.1:3000)
#
# On success: prints the peer assistant's reply text (TaskResult.output) to
# stdout, exits 0. On failure: prints a diagnostic to stderr, exits non-zero.

set -eu

if [ "$#" -lt 2 ]; then
    echo "usage: gtcall <agent_id> <prompt>" >&2
    exit 1
fi

AGENT_ID="$1"
PROMPT="$2"

if [ ! -f /root/.ephemera-flock ]; then
    echo "gtcall: this VM is not part of a flock" >&2
    exit 2
fi

FLOCK_ID="$(awk -F= '/^FLOCK_ID=/{print $2; exit}' /root/.ephemera-flock)"
if [ -z "$FLOCK_ID" ]; then
    echo "gtcall: FLOCK_ID missing from /root/.ephemera-flock" >&2
    exit 2
fi

CP_URL="${EPHEMERA_CONTROL_PLANE:-http://10.0.1.1:3000}"
CP_URL="${CP_URL%/}"

CP_TOKEN=""
if [ -f /root/.ephemera-cp-token ]; then
    CP_TOKEN="$(cat /root/.ephemera-cp-token)"
fi
if [ -z "$CP_TOKEN" ] && [ -n "${EPHEMERA_CONTROL_PLANE_TOKEN:-}" ]; then
    CP_TOKEN="$EPHEMERA_CONTROL_PLANE_TOKEN"
fi

# Forward the nested-invocation depth (v0.4.4). goose-agent injects
# EPHEMERA_TASK_DEPTH into this process's environment as the depth of the task
# that spawned this gtcall; re-send it so the control plane accumulates it and
# enforces EPHEMERA_MAX_TASK_DEPTH. The flock call endpoint counts as a task hop.
DEPTH_HEADER=""
if [ -n "${EPHEMERA_TASK_DEPTH:-}" ]; then
    DEPTH_HEADER="X-Ephemera-Task-Depth: $EPHEMERA_TASK_DEPTH"
fi

# Step 1: build a JSON-safe request body. jq --arg handles embedded newlines,
# backticks, double quotes, and backslashes that LLM-authored prompts may carry.
BODY="$(jq -n --arg id "$AGENT_ID" --arg p "$PROMPT" '{agent_id: $id, prompt: $p}')"

# Step 2: dispatch the prompt to the named agent through the local control plane's
# flock call endpoint. The daemon resolves the agent (locally or via the routed-flock
# home daemon) and injects the target VM's agent token itself. 300s upper bound
# matches the LLM response budget observed during webdev_demo runs (Gemini Flash
# ~30s/call, with headroom for retries inside goose).
if [ -n "$CP_TOKEN" ]; then
    RESP="$(curl -sf -m 300 \
        -H "Authorization: Bearer $CP_TOKEN" \
        -H 'Content-Type: application/json' \
        ${DEPTH_HEADER:+ -H "$DEPTH_HEADER"} \
        -X POST -d "$BODY" \
        "$CP_URL/flocks/$FLOCK_ID/call")" || {
        echo "gtcall: call to $AGENT_ID failed" >&2
        exit 5
    }
else
    RESP="$(curl -sf -m 300 \
        -H 'Content-Type: application/json' \
        ${DEPTH_HEADER:+ -H "$DEPTH_HEADER"} \
        -X POST -d "$BODY" \
        "$CP_URL/flocks/$FLOCK_ID/call")" || {
        echo "gtcall: call to $AGENT_ID failed" >&2
        exit 5
    }
fi

# Step 3: surface only the assistant's text. .output is populated by the in-VM
# goose-agent's extractGooseJSONText helper.
printf '%s\n' "$RESP" | jq -r '.output // empty'
