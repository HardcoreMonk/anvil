# ==========================================
# ephemera - .gitignore
# ==========================================

# 1. Compiled Go binaries
/anvil-daemon
/anvil-mcp
/anvil-scheduler
/e2e-replay-server
/ephemera-daemon
/ephemera-ctl
/goose-daemon
/goose-agent
/cmd/goose-daemon/goose-daemon
*.exe
*.exe~
*.dll
*.so
*.dylib

# 2. Firecracker artifacts & huge files
/artifacts/*
!/artifacts/.keep
*.ext4
*.img
*.bin
*.tgz
vmlinux*

# 3. Unix domain sockets & logs
*.sock
*.log
/tmp/*

# 4. Runtime-generated directories
/internal-recordings/
/snapshots/
/flocks/
/vms/
/audit/
/tmp/

# 5. Goose runtime config (contains API keys)
configs/anvil-mcp.yaml
configs/goose.yaml
configs/goose-secrets.yaml
# Runtime profiles (created via Settings UI or installed by webdev_demo.sh).
# Demo profile assets live under configs/webdev-demo/profiles/ and ARE tracked.
configs/profiles/

# 6. Claude Code context file
CLAUDE.md
Handoff.md
.superpowers/
EPHEMERA_GOOSETOWN_INTEGRATION.md
EPHEMERA_v0.3.1_WORK_ORDER.md
EPHEMERA_v0.3.2_WORK_ORDER.md

# 7. OS & Editor generated files
.vscode/
.idea/
.DS_Store

# 8. Web UI (v0.5.0)
# Source lives in web/. The Vite build output is intentionally committed to
# cmd/goose-daemon/uidist/ (go:embed) so `go build` works without Node — do NOT
# ignore that directory. Only the node toolchain + any stray dist/ are ignored.
/web/node_modules/
/web/dist/
